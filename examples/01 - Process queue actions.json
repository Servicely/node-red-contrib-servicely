[
  {
    "id": "ex-q",
    "type": "tab",
    "label": "Process queue actions",
    "info": "Claims 'ping' actions from the queue, processes them and replies. Any error is reported back with the Failure node."
  },
  {
    "id": "q1",
    "type": "servicely-queue",
    "z": "ex-q",
    "x": 140,
